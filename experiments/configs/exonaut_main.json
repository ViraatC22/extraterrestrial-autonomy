{
  "design_name": "exonaut-confirmatory-v1",
  "planners": [
    "astar",
    "risk_aware_astar",
    "adaptive_risk_aware_astar"
  ],
  "n_seeds": 50,
  "base_config": {
    "size": 64,
    "n_targets": 5,
    "max_steps": 600
  },
  "conditions": [
    {"name": "moon_id", "split": "test", "body": "moon"},
    {"name": "mars_ood", "split": "ood", "body": "mars"},
    {
      "name": "mars_high_uncertainty",
      "split": "ood",
      "body": "mars",
      "overrides": {"terrain_uncertainty": 1.5}
    },
    {
      "name": "mars_faults",
      "split": "ood",
      "body": "mars",
      "overrides": {"fault_rate": 1.0}
    },
    {
      "name": "mars_comm_delay",
      "split": "ood",
      "body": "mars",
      "overrides": {"comm_delay": 20}
    }
  ],
  "output": "exonaut_main.csv"
}
